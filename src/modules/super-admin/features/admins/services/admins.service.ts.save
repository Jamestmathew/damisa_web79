import "server-only";

import { authService } from "@/modules/auth/services";
import { getOffices, assignAdminToOffice, unassignOffice } from "@/modules/super-admin/features/offices/services/offices.service";

import type { AdminRow } from "../types";

function generateTemporaryPassword() {
  return `Welcome-${Math.random().toString(36).slice(2, 8)}`;
}

export async function getAdmins(): Promise<AdminRow[]> {
  const [users, offices] = await Promise.all([authService.listUsers(), getOffices()]);

  return users
    .filter((user) => user.role === "admin")
    .map((user) => {
      const office = offices.find((o) => o.adminId === user.id);
      return {
        id: user.id,
        name: user.name,
        email: user.email,
        status: user.status,
        staffId: user.staffId ?? null,
        createdAt: user.createdAt,
        officeId: office?.id ?? null,
        officeName: office?.name ?? null,
      };
    });
}

export async function createAdmin(input: {
  name: string;
  email: string;
  staffId: string;
  officeId?: string;
}): Promise<{ ok: true; temporaryPassword: string } | { ok: false; error: string; fieldErrors?: Partial<Record<string, string>> }> {
  const temporaryPassword = generateTemporaryPassword();

  const result = await authService.register({
    name: input.name,
    email: input.email,
    password: temporaryPassword,
    confirmPassword: temporaryPassword,
    acceptTerms: true,
    role: "admin",
    status: "active",
    staffId: input.staffId,
  });

  if (!result.ok) {
    return { ok: false, error: result.error, fieldErrors: result.fieldErrors };
  }

  if (input.officeId) {
    await assignAdminToOffice(input.officeId, result.data.user.id, result.data.user.name);
  }

  return { ok: true, temporaryPassword };
}

export async function updateAdmin(
  id: string,
  input: { name: string; email: string; staffId: string; officeId?: string }
): Promise<{ ok: true } | { ok: false; error: string; fieldErrors?: Partial<Record<string, string>> }> {
  const result = await authService.updateUserProfile(id, {
    name: input.name,
    email: input.email,
    staffId: input.staffId,
  });

  if (!result.ok) {
    return { ok: false, error: result.error, fieldErrors: result.fieldErrors };
  }

  const offices = await getOffices();
  const currentOffice = offices.find((o) => o.adminId === id);

  if (currentOffice && currentOffice.id !== input.officeId) {
    await unassignOffice(currentOffice.id);
  }

  if (input.officeId) {
    await assignAdminToOffice(input.officeId, id, input.name);
  }

  return { ok: true };
}

export async function setAdminStatus(
  id: string,
  status: AdminRow["status"]
): Promise<{ ok: true } | { ok: false; error: string }> {
  const result = await authService.setUserStatus(id, status);
  return result.ok ? { ok: true } : { ok: false, error: result.error };
}

export async function resetAdminPassword(
  id: string
): Promise<{ ok: true; temporaryPassword: string } | { ok: false; error: string }> {
  const result = await authService.adminResetPassword(id);
  return result.ok ? { ok: true, temporaryPassword: result.data.temporaryPassword } : { ok: false, error: result.error };
}
